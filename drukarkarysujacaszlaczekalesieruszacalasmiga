import pygame
from pygame.locals import *
from OpenGL.GL import *
from OpenGL.GLU import *

# --- KONFIGURACJA ŚWIATŁA ---
light_ambient = [0.5, 0.5, 0.5, 1.0]
light_diffuse = [1.0, 1.0, 1.0, 1.0]

class Drukarka:
    parts_config = {
        'Rama': ['VERTICES_Calosc', 'SURFACES_Rama'], # Połączona podstawa i rama
        'Oś X': ['VERTICES_osx', 'SURFACES_osx'],
        'Stół': ['VERTICES_bed', 'SURFACES_bed'],
        'Ekstruder': ['VERTICES_Extruder', 'SURFACES_Extruder']
    }

    def __init__(self, part_name, color, pos=None, rot=None):
        self.vertices = getattr(self, self.parts_config[part_name][0])
        self.surfaces = getattr(self, self.parts_config[part_name][1])
        self.color = color
        self.pos = pos if pos else [0.0, 0.0, 0.0]
        self.rot = rot if rot else [0.0, 0.0, 0.0]

    VERTICES_Calosc = (
        (0,0,0), (100,0,0), (100,100,0), (0,100,0),
        (0,0,10), (100,0,10), (100,100,10), (0,100,10),
        (10,10,10), (90,10,10), (90,90,10), (10,90,10),
        (10,10,0), (90,10,0), (90,90,0), (10,90,0),
        (0,30,10), (10,30,10), (10,40,10), (0,40,10),
        (0,30,120), (10,30,120), (10,40,120), (0,40,120),
        (90,30,10), (100,30,10), (100,40,10), (90,40,10),
        (90,30,120), (100,30,120), (100,40,120), (90,40,120),
        (0,30,120), (100,30,120), (100,40,120), (0,40,120),
        (0,30,130), (100,30,130), (100,40,130), (0,40,130),
        (45,10,0), (55,10,0), (55,90,0), (45,90,0),
        (45,10,10), (55,10,10), (55,90,10), (45,90,10)
    )

    SURFACES_Rama = (
        # Płaski dół drukarki i szyna na stół
        (0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6), (3, 0, 4, 7),
        (4, 5, 9, 8), (5, 6, 10, 9), (6, 7, 11, 10), (7, 4, 8, 11),
        (0, 1, 13, 12), (1, 2, 14, 13), (2, 3, 15, 14), (3, 0, 12, 15),
        (8, 9, 13, 12), (9, 10, 14, 13), (10, 11, 15, 14), (11, 8, 12, 15),
        (40, 41, 42, 43), (40, 41, 45, 44), (43, 40, 44, 47), 
        (43, 47, 46, 42), (42, 46, 45, 41), (44, 45, 46, 47),
        # Pionowe słupy i górna belka
        (16, 17, 18, 19), (16, 17, 21, 20), (19, 16, 20, 23), 
        (19, 23, 22, 18), (18, 22, 21, 17), (20, 21, 22, 23),
        (24, 25, 26, 27), (24, 25, 29, 28), (27, 24, 28, 31), 
        (27, 31, 30, 26), (26, 30, 29, 25), (28, 29, 30, 31),
        (32, 33, 34, 35), (32, 33, 37, 36), (35, 32, 36, 39), 
        (35, 39, 38, 34), (34, 38, 37, 33), (36, 37, 38, 39)
    )
    
    VERTICES_osx = (
        (0,40,90), (100,40,90), (100,50,90), (0,50,90),
        (0,40,100), (100,40,100), (100,50,100), (0,50,100)
    )
   
    SURFACES_osx = (
        (0, 1, 2, 3), (0, 1, 5, 4), (3, 0, 4, 7), (3, 7, 6, 2), (2, 6, 5, 1), (4, 5, 6, 7)
    )

    VERTICES_bed = (
        (15,15,15), (85,15,15), (85,85,15), (15,85,15),
        (15,15,20), (85,15,20), (85,85,20), (15,85,20),
        (45,40,10), (55,40,10), (55,60,10), (45,60,10),
        (45,40,15), (55,40,15), (55,60,15), (45,60,15)
    )
    SURFACES_bed = (
        (0, 1, 2, 3), (0, 1, 5, 4), (3, 0, 4, 7), (3, 7, 6, 2), (2, 6, 5, 1), (4, 5, 6, 7),
        (8, 9, 10, 11), (8, 9, 13, 12), (11, 8, 12, 15), (11, 15, 14, 10), (10, 14, 13, 9), (12, 13, 14, 15)
    )

    VERTICES_Extruder = (
        (-10, 50, 90),  (10, 50, 90),  (10, 70, 90),  (-10, 70, 90),
        (-10, 50, 110), (10, 50, 110), (10, 70, 110), (-10, 70, 110),
        (-5, 55, 90),    (5, 55, 90),    (5, 65, 90),    (-5, 65, 90),     
        (0, 60, 82)
    )

    SURFACES_Extruder = (
        (0, 1, 5, 4), (1, 2, 6, 5), (2, 3, 7, 6), (3, 0, 4, 7),
        (4, 5, 6, 7),
        (8, 9, 12, 8),   
        (9, 10, 12, 9),  
        (10, 11, 12, 10),
        (11, 8, 12, 11)  
    )

    def draw(self, material):
        glMaterialfv(GL_FRONT_AND_BACK, GL_AMBIENT, material['ambient'])
        glMaterialfv(GL_FRONT_AND_BACK, GL_DIFFUSE, material['diffuse'])
        glMaterialfv(GL_FRONT_AND_BACK, GL_SPECULAR, material['specular'])
        glMaterialf(GL_FRONT_AND_BACK, GL_SHININESS, material['shininess'])
        
        glPushMatrix()
        glTranslatef(*self.pos)
        glRotatef(self.rot[0], 1, 0, 0)
        glRotatef(self.rot[1], 0, 1, 0)
        glRotatef(self.rot[2], 0, 0, 1)

        glBegin(GL_QUADS)
        for surface in self.surfaces:
            for vertex in surface:
                glVertex3fv(self.vertices[vertex])
        glEnd()
        glPopMatrix()

materials = {
    'red': {'ambient': [0.4, 0.1, 0.1, 1], 'diffuse': [0.9, 0.1, 0.1, 1], 'specular': [0.5,0.5,0.5,1], 'shininess': 32},
    'blue': {'ambient': [0.1, 0.1, 0.4, 1], 'diffuse': [0.1, 0.1, 0.9, 1], 'specular': [0.5,0.5,0.5,1], 'shininess': 32}
}

def main():
    pygame.init()
    display = (1200, 800)
    pygame.display.set_mode(display, DOUBLEBUF | OPENGL)
    
    glMatrixMode(GL_PROJECTION)
    gluPerspective(45, (display[0]/display[1]), 0.1, 1000.0)
    glMatrixMode(GL_MODELVIEW)
    
    # Teraz rama to jeden obiekt łączący dół i słupy
    rama = Drukarka('Rama', [1.0, 0.0, 0.0])
    os_x = Drukarka('Oś X', [0.0, 0.0, 1.0])
    bed = Drukarka('Stół', [0.0, 1.0, 0.0])
    extruder = Drukarka('Ekstruder', [1.0, 1.0, 0.0])
    
    glEnable(GL_DEPTH_TEST)
    glEnable(GL_LIGHTING)
    glEnable(GL_NORMALIZE)   
    glShadeModel(GL_SMOOTH) 
    glLightModelfv(GL_LIGHT_MODEL_AMBIENT, [0.4, 0.4, 0.4, 1.0])
    glEnable(GL_LIGHT0)
    glAnalysePos = glLightfv(GL_LIGHT0, GL_AMBIENT, light_ambient)
    glLightfv(GL_LIGHT0, GL_DIFFUSE, light_diffuse)
    
    # --- ZMIENNE KAMERY ---
    rotate_x, rotate_y = -70, 150  # Początkowa rotacja
    distance = -15                 # Początkowe przybliżenie
    mouse_down = False             # Czy lewy przycisk myszy jest wciśnięty

    tryb_sterowania = 1
    wydrukowane_sciezki = []   # Przechowuje gotowe linie
    aktualna_sciezka = []      # Przechowuje linię, którą właśnie drukujemy

    # --- KONFIGURACJA AUTOMATYCZNEGO DRUKU KOSTKI ---
    auto_drukowanie = False
    auto_indeks_punktu = 0
    
    # --- AUTOMATYCZNY GENERATOR PEŁNEJ KOSTKI ---
    punkty_kostki = []
    
   # Parametry kostki 
    start_x = 40.0
    start_y = -10.0
    szerokosc = 20.0  # Rozmiar X
    dlugosc = 20.0    # Rozmiar Y
    
    odstep_linii = 0.5  
    liczba_warstw = 40 
    skok_warstwy = 0.5 
    # Generujemy warstwy od dołu do góry
    for w in range(liczba_warstw):
        # Obliczamy wysokość osi Z dla danej warstwy
        # Startujemy od -62.0 (czyli realne Z dyszy = 20.0, idealnie na stole)
        aktualne_z = -62.0 + (w * skok_warstwy)
        
        # 1. Rysujemy obrys warstwy (kwadrat)
        punkty_kostki.append([start_x, start_y, aktualne_z])
        punkty_kostki.append([start_x + szerokosc, start_y, aktualne_z])
        punkty_kostki.append([start_x + szerokosc, start_y + dlugosc, aktualne_z])
        punkty_kostki.append([start_x, start_y + dlugosc, aktualne_z])
        punkty_kostki.append([start_x, start_y, aktualne_z]) # Zamknięcie obrysu
        
        # 2. Rysujemy wypełnienie (Zygzak wewnątrz kwadratu)
        # Przesuwamy się liniami wzdłuż osi Y
        aktualne_y = start_y + odstep_linii
        kierunek_x = True # Zmienna do sterowania ruchem lewo/prawo
        
        while aktualne_y < (start_y + dlugosc):
            if kierunek_x:
                # Linia w prawo
                punkty_kostki.append([start_x + odstep_linii, aktualne_y, aktualne_z])
                punkty_kostki.append([start_x + szerokosc - odstep_linii, aktualne_y, aktualne_z])
            else:
                # Linia w lewo
                punkty_kostki.append([start_x + szerokosc - odstep_linii, aktualne_y, aktualne_z])
                punkty_kostki.append([start_x + odstep_linii, aktualne_y, aktualne_z])
            
            aktualne_y += odstep_linii
            kierunek_x = not kierunek_x # Zmiana kierunku dla następnej linii

    clock = pygame.time.Clock()
    
    while True:
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                pygame.quit()
                return
            
            # Obsługa myszy
            elif event.type == pygame.MOUSEBUTTONDOWN:
                if event.button == 1: mouse_down = True  # Lewy przycisk
                if event.button == 4: distance += 1.0    # Scroll w górę (przybliż)
                if event.button == 5: distance -= 1.0    # Scroll w dół (oddal)
            
            elif event.type == pygame.MOUSEBUTTONUP:
                if event.button == 1: mouse_down = False
            
            elif event.type == pygame.MOUSEMOTION:
                if mouse_down:
                    dx, dy = event.rel
                    rotate_y += dx  # Obrót wokół osi Z (horyzontalnie)
                    rotate_x += dy  # Obrót góra/dół

        keys = pygame.key.get_pressed()
        
        # Wybór trybu
        if keys[K_1]: tryb_sterowania = 1
        if keys[K_2]: tryb_sterowania = 2
        
        # Uruchomienie autodruku klawiszem 4
        if keys[K_4] and not auto_drukowanie:
            auto_drukowanie = True
            auto_indeks_punktu = 0
            # Teleportujemy drukarkę do punktu startowego, żeby zaczęła od czystego miejsca
            extruder.pos[0] = punkty_kostki[0][0]
            bed.pos[1] = punkty_kostki[0][1]
            os_x.pos[2] = punkty_kostki[0][2]

        # Ruch belki w pionie (Z) zostawiamy stale pod strzałkami GÓRA/DÓŁ
        if keys[K_UP] and os_x.pos[2] < 20: os_x.pos[2] += 0.5 
        if keys[K_DOWN] and os_x.pos[2] > -70: os_x.pos[2] -= 0.5

        # Ruch na boki pod strzałkami LEWO/PRAWO zależy od trybu:
        if tryb_sterowania == 1:
            # Ruch ekstrudera wzdłuż belki (oś X)
            if keys[K_LEFT] and extruder.pos[0] > 10: extruder.pos[0] -= 0.5
            if keys[K_RIGHT] and extruder.pos[0] < 90: extruder.pos[0] += 0.5
            
        elif tryb_sterowania == 2:
            # Ruch stołu (bed) w głąb / do przodu (oś Y)
            if keys[K_LEFT] and bed.pos[1] > -35: bed.pos[1] -= 0.5
            if keys[K_RIGHT] and bed.pos[1] < 35: bed.pos[1] += 0.5

        # --- LOGIKA AUTOMATYCZNEGO DRUKU ---
        if auto_drukowanie:
            cel = punkty_kostki[auto_indeks_punktu]
            predkosc = 2 # Prędkość druku (im mniejsza, tym dokładniejszy druk)
            
            # Flagi informujące, czy dana oś dotarła do celu
            dotarl_x = False
            dotarl_y = False
            dotarl_z = False
            
            # Ruch osi X (Ekstruder)
            if abs(extruder.pos[0] - cel[0]) <= predkosc:
                extruder.pos[0] = cel[0]
                dotarl_x = True
            else:
                extruder.pos[0] += predkosc if extruder.pos[0] < cel[0] else -predkosc
                
            # Ruch osi Y (Stół)
            if abs(bed.pos[1] - cel[1]) <= predkosc:
                bed.pos[1] = cel[1]
                dotarl_y = True
            else:
                bed.pos[1] += predkosc if bed.pos[1] < cel[1] else -predkosc
                
            # Ruch osi Z (Belka osi X)
            if abs(os_x.pos[2] - cel[2]) <= predkosc:
                os_x.pos[2] = cel[2]
                dotarl_z = True
            else:
                os_x.pos[2] += predkosc if os_x.pos[2] < cel[2] else -predkosc
                
            # Jeśli wszystkie osie dotarły do aktualnego punktu, przechodzimy do następnego
            if dotarl_x and dotarl_y and dotarl_z:
                auto_indeks_punktu += 1
                if auto_indeks_punktu >= len(punkty_kostki):
                    # Koniec drukowania! Szczęśliwy finał
                    auto_drukowanie = False
                    if aktualna_sciezka:
                        wydrukowane_sciezki.append(aktualna_sciezka)
                        aktualna_sciezka = []


# --- MECHANIKA DRUKOWANIA Z OGRANICZENIEM DO STOŁU (WERSJA V3 - HACZYK W DÓŁ) ---
        if keys[K_SPACE] or auto_drukowanie:
            # 1. Obliczamy pozycję dyszy względem świata 3D
            pozycja_dyszy_swiat_x = extruder.pos[0] + 0.0
            pozycja_dyszy_swiat_y = 60.0  
            pozycja_dyszy_swiat_z = extruder.pos[2] + 82.0  

            # 2. Aktualne, ruchome granice stołu w świecie 3D
            stol_min_x = 15.0
            stol_max_x = 85.0
            stol_min_y = 15.0 + bed.pos[1]
            stol_max_y = 85.0 + bed.pos[1]
            stol_poziom_z = 20.0  

            # 3. Sprawdzamy, czy dysza jest w rzucie z góry nad stołem
            nad_stolem = (stol_min_x <= pozycja_dyszy_swiat_x <= stol_max_x) and \
                         (stol_min_y <= pozycja_dyszy_swiat_y <= stol_max_y)

            # 4. Pierwsza warstwa bezpośrednio na stole
            na_powierzchni_stolu = nad_stolem and (abs(pozycja_dyszy_swiat_z - stol_poziom_z) <= 1.5)

            # 5. Logika nadbudowy (nad plastikiem, obok plastiku, pod plastikiem)
            w_powietrzu_ale_na_plastiku = False
            w_powietrzu_ale_pod_plastikiem = False
            
            # Pozycję Y musimy przeliczyć na układ względny stołu, bo tak zapisane są punkty w pamięci
            pozycja_wzgledna_y = 60.0 - bed.pos[1]
            
            # --- POPRAWKA: Sprawdzaj również aktualnie drukowaną ścieżkę ---
            wszystkie_do_sprawdzenia = wydrukowane_sciezki.copy()
            if aktualna_sciezka:
                wszystkie_do_sprawdzenia.append(aktualna_sciezka)

            for sciezka in wszystkie_do_sprawdzenia:
                for pkt in sciezka:
                    # Odległości w osiach X, Y i Z między dyszą a sprawdzanym punktem z historii
                    dx = pozycja_dyszy_swiat_x - pkt[0]
                    dy = pozycja_wzgledna_y - pkt[1]
                    dz = pozycja_dyszy_swiat_z - pkt[2]
                    
                    # WARUNEK A: Budowanie w górę (filar)
                    if (dx**2 + dy**2) < 4.0 and (0.0 <= dz <= 4.5):
                        w_powietrzu_ale_na_plastiku = True
                        break
                        
                    # WARUNEK B: Budowanie w bok (ramiona litery T)
                    if abs(dz) <= 1.5 and (dx**2 + dy**2) < 9.0:
                        w_powietrzu_ale_na_plastiku = True
                        break

                    # WARUNEK C: Budowanie w dół (Haczyk pod plastikiem)
                    # Sprawdzamy czy dysza jest TUŻ POD istniejącym punktem (dz jest ujemne, np. od -4.5 do 0.0)
                    # i czy w osiach X/Y jesteśmy idealnie pod tą linią
                    if (dx**2 + dy**2) < 4.0 and (-4.5 <= dz <= 0.0):
                        w_powietrzu_ale_pod_plastikiem = True
                        break
                if w_powietrzu_ale_na_plastiku or w_powietrzu_ale_pod_plastikiem:
                    break

            # 6. Decyzja o drukowaniu:
            # Zezwalamy jeśli: jesteśmy na stole LUB nad plastikiem LUB pod plastikiem (wtedy stół nas nie obchodzi!)
            if na_powierzchni_stolu or w_powietrzu_ale_na_plastiku or w_powietrzu_ale_pod_plastikiem:
                pozycja_dyszy_wzgledna = (
                    pozycja_dyszy_swiat_x,
                    pozycja_wzgledna_y,
                    pozycja_dyszy_swiat_z
                )
                
                if not aktualna_sciezka:
                    aktualna_sciezka.append(pozycja_dyszy_wzgledna)
                else:
                    ostatni_punkt = aktualna_sciezka[-1]
                    dystans = (pozycja_dyszy_wzgledna[0] - ostatni_punkt[0])**2 + \
                              (pozycja_dyszy_wzgledna[1] - ostatni_punkt[1])**2 + \
                              (pozycja_dyszy_wzgledna[2] - ostatni_punkt[2])**2
                    if dystans > 0.5:
                        aktualna_sciezka.append(pozycja_dyszy_wzgledna)
            else:
                if aktualna_sciezka:
                    wydrukowane_sciezki.append(aktualna_sciezka)
                    aktualna_sciezka = []
        else:
            if aktualna_sciezka:
                wydrukowane_sciezki.append(aktualna_sciezka)
                aktualna_sciezka = []

        glClearColor(0.15, 0.15, 0.15, 1.0)
        glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT)
        glLoadIdentity()
        
        # --- ZASTOSOWANIE TRANSFORMACJI KAMERY ---
        glTranslatef(0, 0, distance)  # Przybliżenie
        glRotatef(rotate_x, 1, 0, 0)  # Obrót góra/dół
        glRotatef(rotate_y, 0, 0, 1)  # Obrót 360 wokół drukarki

        glLightfv(GL_LIGHT0, GL_POSITION, [0, 0, 10, 1])

        glPushMatrix()
        glScalef(0.05, 0.05, 0.05)
        glTranslatef(-50, -50, -5) 
        
        # --- SYNCHRONIZACJA RUCHOMYCH CZĘŚCI ---
        extruder.pos[2] = os_x.pos[2]  # Z - wysokość (razem z osią X)
        # Zarówno os_x, jak i extruder w osi Y stoją sztywno (Y=0), bo rusza się stół!
        os_x.pos[1] = 0.0
        extruder.pos[1] = 0.0
        
        # Rysowanie obiektów
        rama.draw(materials['red'])
        os_x.draw(materials['blue'])
        extruder.draw(materials['blue'])
        bed.draw(materials['blue'])

        # --- RYSOWANIE FILAMENTU ---
        glDisable(GL_LIGHTING)  
        glLineWidth(4.0)        
        glColor3f(1.0, 1.0, 1.0) 

        wszystkie_sciezki = wydrukowane_sciezki.copy()
        if aktualna_sciezka:
            wszystkie_sciezki.append(aktualna_sciezka)

        # Kluczowy moment: przesuwamy rysowanie linii dokładnie tak samo jak stół,
        # dzięki czemu linie przesuwają się razem z nim w osi Y!
        glPushMatrix()
        glTranslatef(0.0, bed.pos[1], 0.0)

        for sciezka in wszystkie_sciezki:
            glBegin(GL_LINE_STRIP)
            for punkt in sciezka:
                glVertex3fv(punkt)
            glEnd()
            
        glPopMatrix() # Cofnięcie przesunięcia stołu dla linii
        glEnable(GL_LIGHTING)   
        
        glPopMatrix() # To zamyka głównego glPushMatrix
        
        pygame.display.flip()
        clock.tick(60)

if __name__ == "__main__":
    main()
